# Dependencies, installed by Composer.
/vendor/

# A local copy of Composer, used by tools/build-phar.php in preference to
# whichever `composer` happens to be on the PATH so that the archive is built
# with the version whoever installed the dependencies used.
/composer.phar

# The lock file *is* committed, so a build is repeatable rather than resolving
# whatever is newest that morning. The `dependencies` job in tests.yml resolves
# afresh on a schedule, which is how a new release still gets tested.
/composer.runtime.json
/composer.runtime.lock

# Everything the build produces.

# The phar, and the directory it is assembled in.
/build/

# The documents and previews examples/build.php writes.
/examples/out/

# Scratch space for the tests and the checking scripts.
/tmp/

# What the phar workflow's own checks used to write into the repository root
# before it was told to use `tmp/` like everything else. They are here as well
# so that an old run, or a run from a branch that has not been merged, does not
# leave them showing up as untracked files.
/check.md
/check.docx
/round-trip.md

# Test runner state.
/.phpunit.cache/
/.phpunit.result.cache

# A local override; the committed configuration is phpunit.xml.dist.
/phpunit.xml

# Coverage reports, if written next to the project rather than into build/.
/coverage/
/coverage.xml
/clover.xml

# Editors and operating systems.
.DS_Store
.idea/
.vscode/
*.swp
*~

# Word's owner file, written beside a document while it is open and removed when it
# closes. One was committed by accident, from `examples/templates`, which is the only
# directory in the repository a person has a reason to open a document in.
~$*

# Parallel agent worktrees
.worktrees/
