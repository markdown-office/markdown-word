{
    "name": "markdown-office/markdown-word",
    "description": "Pure PHP Markdown to Word (DOCX) generator and back, built on PHPWord. Full CommonMark and GitHub-Flavored Markdown support, configurable styling, Word template rendering, and a table of contents, footnotes and a document's own header and footer.",
    "type": "library",
    "keywords": [
        "markdown",
        "docx",
        "word",
        "phpword",
        "commonmark",
        "gfm",
        "converter",
        "template",
        "pandoc"
    ],
    "license": "MIT",
    "authors": [
        {
            "name": "Fabian Graßl",
            "email": "mail@fabiangrassl.de"
        }
    ],
    "require": {
        "php": "^8.2",
        "cweagans/composer-patches": "^2.0",
        "ext-dom": "*",
        "ext-gd": "*",
        "ext-mbstring": "*",
        "ext-zip": "*",
        "league/commonmark": "^2.10",
        "markdown-office/commonmark-generic-directives": "^0.3.0",
        "phpoffice/phpword": "~1.4.0",
        "symfony/yaml": "^7.4 || ^8.1"
    },
    "require-dev": {
        "pestphp/pest": "^5.0"
    },
    "suggest": {
        "ext-imagick": "Embeds SVG as a vector. Word holds an SVG only beside a raster of it, so something has to draw the raster; without this an SVG raises instead of going in."
    },
    "extra": {
        "patches": {
            "phpoffice/phpword": [
                {
                    "description": "PHPWord 1.4.0 writes the children of `w:rPr`, of `w:pPr`, of `w:tblPr`, of `w:sectPr` and of `w:style` in an order of its own, and writes a few elements the format does not allow there. The patch puts them where ECMA-376 names them. The version is held to the 1.4 line rather than the 1 series: the patch is against 1.4.0, and a later release of the line would carry a different writer.",
                    "url": "https://raw.githubusercontent.com/markdown-office/PHPWord/051ec089fd5f90c55d3b2f5075073337706a0bfc/patches/phpoffice-phpword-1.4.0-ooxml.patch",
                    "sha256": "e72862a34778f5c1e6e85ea7b006c0e297a1c178c9fa30afb1a4c27320ef2f3c"
                }
            ]
        }
    },
    "autoload": {
        "psr-4": {
            "MarkdownWord\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "MarkdownWord\\Tests\\": "tests/"
        }
    },
    "config": {
        "sort-packages": true,
        "allow-plugins": {
            "cweagans/composer-patches": true,
            "pestphp/pest-plugin": true
        }
    },
    "scripts": {
        "test": "pest",
        "test:unit": "pest --testsuite=unit",
        "test:spec": "pest --testsuite=conformance",
        "test:roundtrip": "pest --testsuite=roundtrip",
        "test:readme": "pest --testsuite=readme",
        "test:ooxml": "pest --testsuite=ooxml",
        "test:coverage": "pest --coverage --min=91 --coverage-clover=build/coverage/clover.xml --coverage-html=build/coverage/html",
        "check": [
            "@composer validate --strict",
            "@check:audit",
            "@php smoke.php",
            "@php stress.php",
            "@php vendor/bin/pest"
        ],
        "check:audit": "@composer audit --no-interaction",
        "check:coverage": "@test:coverage"
    }
}
